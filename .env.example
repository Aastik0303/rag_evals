# =====================================================================
# Copy this file to .env and fill in your keys:  cp .env.example .env
# Everything here is read by src/config.py.
# =====================================================================

# ---------------------------------------------------------------------
# CHAT + JUDGE MODEL  (any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------
# groq   -> https://console.groq.com/keys      (default; fast + free tier)
# xai    -> https://console.x.ai               (xAI's Grok)
# openai -> https://platform.openai.com/api-keys
LLM_PROVIDER=groq

# Key for the provider above. Only the matching one has to be filled in.
GROQ_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=

# The model that ANSWERS (src/generator.py).
# groq:   openai/gpt-oss-120b | openai/gpt-oss-20b | qwen/qwen3.8-27b
#         (Groq's catalogue changes -- run `python -m src.config --list-models`)
# xai:    grok-4-fast | grok-3-mini
CHAT_MODEL=openai/gpt-oss-120b

# The model that JUDGES the evals. Defaults to CHAT_MODEL, but a different
# judge than the answerer gives you less self-flattering scores.
JUDGE_MODEL=openai/gpt-oss-120b

CHAT_TEMPERATURE=0

# Only needed for a provider that isn't in the table above (Ollama, OpenRouter,
# Together, a vLLM server, ...). Leave blank to use the provider's own URL.
# LLM_BASE_URL=
# LLM_API_KEY=

# ---------------------------------------------------------------------
# RATE LIMITS (free tiers are tight -- Groq's on-demand tier is 8k TPM)
# ---------------------------------------------------------------------
# Retries on 429, with the provider's Retry-After honoured.
LLM_MAX_RETRIES=8
LLM_TIMEOUT=120

# How many judge calls DeepEval runs at once, and the pause between them.
# 1 + 1s keeps a retrieval eval inside an 8k TPM budget; raise both on a paid tier.
EVAL_MAX_CONCURRENT=1
EVAL_THROTTLE=1

# Per-test-case budget for DeepEval, including 429 backoff (default is 180s,
# far too short when a free tier makes you wait).
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=900

# ---------------------------------------------------------------------
# EMBEDDINGS  (HuggingFace)
# ---------------------------------------------------------------------
# local -> runs on your machine via sentence-transformers. Free, no key, and
#          offline after the first download (~130MB for bge-small).
# api   -> calls the HF Inference API instead (needs the token below).
EMBEDDING_MODE=local

# Good local choices, small to large:
#   sentence-transformers/all-MiniLM-L6-v2   (384d, fastest)
#   BAAI/bge-small-en-v1.5                   (384d, better retrieval)
#   BAAI/bge-base-en-v1.5                    (768d)
#   intfloat/e5-large-v2                     (1024d, slowest)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# cpu, or cuda if you have an NVIDIA GPU + a CUDA build of torch
EMBEDDING_DEVICE=cpu

# https://huggingface.co/settings/tokens -- required only for EMBEDDING_MODE=api
# HUGGINGFACEHUB_API_TOKEN=

# ---------------------------------------------------------------------
# VECTOR STORE
# ---------------------------------------------------------------------
# Chroma cannot mix vector dimensions in one collection, so give each embedding
# model its own directory (e.g. chroma_store_bge_small) when you switch models.
CHROMA_DIR=chroma_store

# ---------------------------------------------------------------------
# COST EVAL PRICING (USD per 1M tokens, used by evals/eval_cost.py + eval_ops.py)
# ---------------------------------------------------------------------
# Defaults are Groq openai/gpt-oss-120b. Update when you change model.
PRICE_INPUT_PER_1M=0.15
PRICE_CACHED_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.75

# ---------------------------------------------------------------------
# LOCAL CACHES (keep downloads inside the project, off C:)
# ---------------------------------------------------------------------
# HuggingFace model downloads: embeddings + the cross-encoder reranker.
HF_HOME=./.cache/huggingface
